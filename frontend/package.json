{
  "name": "restaurant-pos-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "RPOS cashier PWA — Vue 3 + Vite",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "//resolutions": [
    "`@vue/test-utils` pulls `js-beautify` for snapshot pretty-printing, which",
    "pulls `editorconfig@3`, which demands Node 20. The bench in WSL runs Node",
    "18 and builds ERPNext's assets with it, so raising Node there to satisfy a",
    "test formatter is the wrong end to fix. `editorconfig@2` is the same",
    "library one major earlier and runs on 18."
  ],
  "resolutions": {
    "editorconfig": "^2.0.0"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.28.0",
    "fake-indexeddb": "^6.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.0"
  }
}
