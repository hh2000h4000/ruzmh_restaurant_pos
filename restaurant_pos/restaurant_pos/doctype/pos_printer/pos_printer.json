  },
  {
   "description": "Which agent puts paper through this printer. A network printer in the kitchen belongs to the branch's agent; a USB printer belongs to the agent on the machine it is plugged into. Naming an owner is what stops five tills each printing the same ticket.",
   "fieldname": "print_agent",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Print Agent",
   "options": "POS Print Agent"
  },
  {
   "default": "network",
   "description": "network: by IP address. windows: a printer installed in Windows on the agent's machine — the usual way for a USB printer on a Windows PC (D-212). usb: direct USB by vendor and product id, for an agent on Linux or a Raspberry Pi.",
   "fieldname": "connection_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "label": "Connection Type",
   "options": "network\nwindows\nusb",
   "reqd": 1
  },
