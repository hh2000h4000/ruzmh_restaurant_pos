  },
  {
   "depends_on": "eval:doc.connection_type=='usb'",
   "description": "Hex, e.g. 0202",
   "fieldname": "usb_product_id",
   "fieldtype": "Data",
   "label": "USB Product ID",
   "mandatory_depends_on": "eval:doc.connection_type=='usb'"
  },
  {
   "depends_on": "eval:doc.connection_type=='windows'",
   "description": "Exactly as Windows lists it under Printers & scanners, e.g. POS-X Thermal Printer. The agent sends the ticket's bytes to it unchanged, so the printer stays usable by every other program.",
   "fieldname": "windows_printer_name",
   "fieldtype": "Data",
