 "content": "[{\"id\": \"rpos_head\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\">Restaurant POS</span>\", \"col\": 12}}, {\"id\": \"rpos_intro\", \"type\": \"paragraph\", \"data\": {\"text\": \"<b>The till itself is at /restaurant-pos</b> — this page is the office behind it: the menu, the floor, the shifts and the trail. A cashier never needs to come here, and nothing on this page is where an order is taken.\", \"col\": 12}}, {\"id\": \"rpos_sc1\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Open the till\", \"col\": 3}}, {\"id\": \"rpos_sc2\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Restaurant Orders\", \"col\": 3}}, {\"id\": \"rpos_sc3\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Restaurant Shifts\", \"col\": 3}}, {\"id\": \"rpos_sc4\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"POS Permissions\", \"col\": 3}}, {\"id\": \"rpos_spacer\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"rpos_card1\", \"type\": \"card\", \"data\": {\"card_name\": \"Service\", \"col\": 4}}, {\"id\": \"rpos_card2\", \"type\": \"card\", \"data\": {\"card_name\": \"The floor\", \"col\": 4}}, {\"id\": \"rpos_card3\", \"type\": \"card\", \"data\": {\"card_name\": \"The day and the drawer\", \"col\": 4}}, {\"id\": \"rpos_card4\", \"type\": \"card\", \"data\": {\"card_name\": \"The menu\", \"col\": 4}}, {\"id\": \"rpos_card5\", \"type\": \"card\", \"data\": {\"card_name\": \"Terminals\", \"col\": 4}}, {\"id\": \"rpos_card6\", \"type\": \"card\", \"data\": {\"card_name\": \"People and the trail\", \"col\": 4}}, {\"id\": \"rpos_card7\", \"type\": \"card\", \"data\": {\"card_name\": \"Loyalty points\", \"col\": 4}}]",
